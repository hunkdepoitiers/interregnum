{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Interregnum",
  "version": "0.1.0",
  "identifier": "com.hunkdepoitiers.interregnum",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Interregnum",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Grand strategy from 1314"
  }
}
